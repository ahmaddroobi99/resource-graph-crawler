# Copy to .env for local / Docker production.

RGC_ENV=production
RGC_SERVICE_NAME=resource-graph-crawler
RGC_BASE_URL=http://54.214.7.161/
RGC_ALLOWED_HOST=54.214.7.161
RGC_USERNAME=ahmad.droobi2
RGC_PASSWORD=change-me
RGC_MAX_PAGES=2000
RGC_REQUEST_TIMEOUT=10
RGC_USER_AGENT=ResourceGraphCrawler/1.1

# Public API safety caps (Vercel / HTTP control plane)
RGC_API_MAX_PAGES=12
RGC_API_MAX_WORKERS=4

# Optional. When set, POST /api/v1/crawl requires Authorization: Bearer <key>
RGC_API_KEY=

# Required for local/Docker document APIs and /documents UI.
# Use a long random value; never expose this service directly without authentication.
RGC_DOCUMENT_API_KEY=replace-with-a-long-random-key
RGC_DOCUMENT_DB_PATH=data/documents.sqlite3
RGC_DOCUMENT_UPLOAD_DIR=data/uploads
RGC_DOCUMENT_MAX_UPLOAD_SIZE_BYTES=20971520
RGC_DOCUMENT_MAX_PAGES=100
RGC_DOCUMENT_MAX_PIXELS=50000000
RGC_DOCUMENT_MAX_OCR_SECONDS=30
RGC_DOCUMENT_MAX_PROCESSING_SECONDS=600
RGC_DOCUMENT_MAX_ATTEMPTS=3
RGC_DOCUMENT_RETRY_BASE_MILLISECONDS=500
RGC_DOCUMENT_WORKER_POLL_MILLISECONDS=500

# Optional German / geo proxy for /status/eu-region/
# VP_PROXY=socks5h://127.0.0.1:1080
